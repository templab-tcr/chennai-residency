NODE_ENV=production
PORT=3000
JWT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS

# MySQL / MariaDB (GoDaddy cPanel: host is normally "localhost";
# database and user names carry your cPanel prefix, e.g. cpuser_chennai)
DB_HOST=localhost
DB_PORT=3306
DB_USER=cpuser_chennai
DB_PASSWORD=CHANGE_ME
DB_NAME=cpuser_chennai
# (alternative) DATABASE_URL=mysql://user:password@localhost:3306/dbname
DB_POOL=5
DB_SSL=false

# Creates the tables + admin on first start. Set to false to disable.
AUTO_SETUP=true
ADMIN_EMAIL=admin@thechennairesidency.com
ADMIN_PASSWORD=chennai1234567
# Optional: pre-approve a first admin device (min 8 chars, keep secret)
BOOTSTRAP_DEVICE_CODE=

# Your site URL(s), comma separated (same-host requests are always allowed)
CORS_ORIGINS=https://yourdomain.com,http://localhost:3000
